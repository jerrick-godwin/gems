{
  "version": 2,
  "framework": "vite",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**"
    }
  },
  "routes": [
    {
      "src": "^/api/v1(?:/.*)?$",
      "dest": "/api/index.ts"
    },
    {
      "src": "^/$",
      "dest": "/api/index.ts"
    },
    {
      "src": "^/(?:robots\\.txt|sitemap\\.xml)$",
      "dest": "/api/index.ts"
    },
    {
      "src": "^/listings/[^/]+/?$",
      "dest": "/api/index.ts"
    },
    {
      "src": "^/media/listings/[^/]+/photos/[0-9]+(?:/thumbnail\\.webp)?$",
      "dest": "/api/index.ts"
    },
    {
      "src": "^/gemstones/[^/]+/?$",
      "dest": "/api/index.ts"
    },
    {
      "src": "^/(?:buy-gemstones|sell-gemstones|about-us|gemstones|guides/buying-gemstones-online|guides/gemstone-certification-and-treatments)/?$",
      "dest": "/api/index.ts"
    },
    {
      "src": "^/[A-Za-z0-9-]{8,128}\\.txt$",
      "dest": "/api/index.ts"
    },
    {
      "src": "^/(?:contact-us|terms-and-conditions|privacy-policy|refund-policy)/?$",
      "dest": "/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/admin/?$",
      "dest": "/admin.html",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      }
    },
    {
      "src": "^/(?:login|signup|forgot-password|post(?:/.*)?|profile|reports|listings|receipt)/?$",
      "dest": "/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      }
    },
    {
      "src": "^/.*$",
      "dest": "/index.html"
    }
  ]
}
