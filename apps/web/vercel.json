{
  "version": 2,
  "framework": "vite",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**"
    }
  },
  "routes": [
    {
      "src": "^/api/v1(?:/.*)?$",
      "dest": "/api/index.ts"
    },
    {
      "src": "^/$",
      "dest": "/api/index.ts"
    },
    {
      "src": "^/(?:robots\\.txt|sitemap\\.xml)$",
      "dest": "/api/index.ts"
    },
    {
      "src": "^/listings/[^/]+/?$",
      "dest": "/api/index.ts"
    },
    {
      "src": "^/(?:contact-us|terms-and-conditions|privacy-policy|refund-policy)/?$",
      "dest": "/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/admin/?$",
      "dest": "/admin.html"
    },
    {
      "src": "^/.*$",
      "dest": "/index.html"
    }
  ]
}
